PROJECT_NAME="Visual Inspiration Boards (Collaborative Moodboard Platform)"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=true

# Database: PostgreSQL in Docker, or SQLite for local dev
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/visual_boards"
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./visual_boards.db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=true
